# Stripe (get these from https://dashboard.stripe.com/apikeys — use test keys while developing)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Get this from the Stripe CLI or your webhook endpoint settings once deployed
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Currency to charge in (lowercase ISO code, used by Stripe). South African Rand shown as example.
CURRENCY=zar
# Same currency, uppercase, used for on-page price formatting.
NEXT_PUBLIC_CURRENCY=ZAR

# Admin login for /admin
ADMIN_USERNAME=jay
ADMIN_PASSWORD=changeme123
# Any long random string — used to sign the admin login session
JWT_SECRET=please-change-this-to-a-long-random-string

# Public site URL (used for Stripe redirect links). Update after deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
